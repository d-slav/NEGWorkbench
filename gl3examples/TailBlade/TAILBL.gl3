*
*   Program TAILBLADE
*
*   V Surface workbench vytvorit plochy a uzavrit.
*   V Curves workbench vytvorit z ploch parametric solid
*   V Part design workbench vytvorit z parametric solid clone (base feature)
*
*
SUBRO/TAILBL/out:HTIP,out:HROOT,out:T(2)

DL=110      < delka listu
DKH=30      < hloubka u korene
DTH=25      < hloubka na konci
DKN=8       < Y nabezne hrany u korene
DTN=5.6     < Y nabezne hrany na konci
DODT=0.5    < Tloustka odtokovky

ACCUR,0.001
CALL/EODT/DL,DKH,DTH,DKN,DTN,EODT
CALL/ENAB/DL,DKH,DTH,DKN,DTN,ENAB
CALL/ETWIST/DL,DKH,DTH,DKN,DTN,ETWI

DODTLEN=D28>EODT    < Delka odtokové hrany

* Vypocet bodu na retezci pro stanovení polohy rezu.

ICOUNT=30
DIMEN,DD(30),PODT(30),PNAB(30),PTWI(30),T(30)

CALL/SINSPL/DODTLEN,ICOUNT,0,135,DD

WRITE,DD

*RETSUB

* Vypocet bodu na nabezce a odtokovce

PODT(1)=P48>EODT,1
PNAB(1)=P48>ENAB,1
PTWI(1)=P48>ETWI,1
DO,I=2,ICOUNT-1
    PODT(I)=P58>PODT(1),EODT,DD(I)
    PNAB(I)=P66>ENAB,(D30>PODT(I),1),10
    PTWI(I)=P66>ETWI,(D30>PODT(I),1),10
ENDDO
PODT(ICOUNT)=P48>EODT,(NPO>EODT)
PNAB(ICOUNT)=P48>ENAB,(NPO>ENAB)
PTWI(ICOUNT)=P48>ETWI,(NPO>ETWI)

*WRITE,PODT,PNAB,PTWI

*RETSUB

DIMEN,TF(81),Q(81),P(81)
CALL/TFOIL/DL,TF,K

DIMEN,PPP(2)

* Mame vse potrebne k vytvoreni rezu

*ICOUNT=7
DO,I=1,ICOUNT
PRINT,I
    DZ=D30>PODT(I),1
    DHLO=D10>PNAB(I),PODT(I)
    RFOIL=R01>UZ,DZ
    DO,J=1,K
        Q(J)=Q38>TF(J),RFOIL,1
        P(J)=P00>(D30>Q(J),1),(D30>Q(J),2)
    ENDDO
*PRINT,DHLO,DODT
*WRITE,Q
    CALL/HLOCUT/K,P,DHLO,DODT,SS
    DTWI=D30>PTWI(I),2
    UTWIST=U19>UX,MZ,DTWI,21
    DOFF=(DL-DZ)/DL*0.4
    DCOOS3,1,(Q00>-(D30>PNAB(I),2),(DTWI*-0.1+DOFF),DZ),UTWIST,(U00>0,-1,0)
    <DCOOS3,1,(Q00>-(D30>PNAB(I),2),0,DZ),UTWIST,UY
    TRA23,T(I),SS,1,1                           
    <WRITE,SS
    <S(I)=S01>P,K
*    MOVE/S:0*S
*    IFI/I.EQ.1/THEN
*        PPP(1)=P48>SS,1
*        PPP(2)=P48>SS,(NPO>SS)
*        EE=E01>PPP,2
*        TRA23,HTIP,EE,1,1
*    ENDIF
*    IFI/I.EQ.ICOUNT/THEN
*        PPP(1)=P48>SS,1
*        PPP(2)=P48>SS,(NPO>SS)
*        EE=E01>PPP,2
*        TRA23,HROOT,EE,1,1
*    ENDIF
ENDDO

HTIP =H02>(Q48>T(1),     1),(Q48>T(1),     (NPO>T(1)))
HROOT=H02>(Q48>T(ICOUNT),1),(Q48>T(ICOUNT),(NPO>T(ICOUNT)))

RETSUB
END

