*
*    Podprogram SINSPL
*
SUBRO/SINSPL/in:DDIST,in:ICOUNT,in:DSTART,in:DSTOP,out:DD(2)

IFN/DSTART/DSTART=0
IFN/DSTOP/DSTOP=180

DSUM=0
ICOUNT=ICOUNT-1
ASTEP=(DSTOP-DSTART)/ICOUNT

DIMEN,DWEIGHT(50)

*PRINT,ASTEP

DO,I=1,ICOUNT
    DMID=DSTART+(ASTEP*(I-1))+(ASTEP/2)
    DWEIGHT(I)=ABS>(SIN>DMID)
    DSUM=DSUM+DWEIGHT(I)
    
ENDDO

*PRINT,DSUM
*WRITE,DWEIGHT

DSUMR=0

DO,I=1,ICOUNT
    DD(I)=DSUMR
    DDI=(DWEIGHT(I)/DSUM)*DDIST
    DSUMR=DSUMR+DDI
ENDDO
DD(ICOUNT+1)=DSUMR

*PRINT,DSUMR
*WRITE,DD

RETSUB
END

