*
*    Podprogram DSPLIT
*
SUBRO/DSPLIT/in:DDIST,in:DFIRST,in:ICOUNT,out:DRATIO,out:DD(2)

DTARGET=DDIST/DFIRST
DLOW=1.0
DHIGH=1.0

DO,J=1,1000
    DHIGH=DHIGH*2
    CALL/GEOSUM/DHIGH,(ICOUNT-2),D
    IFD/D.GE.DTARGET/THEN
        J=1000
    ENDIF
ENDDO

DO,J=0,150
    DMID=(DLOW+DHIGH)/2
    CALL/GEOSUM/DMID,(ICOUNT-2),D

    IFD/D.LT.DTARGET/DLOW=DMID
    IFD/D.GE.DTARGET/DHIGH=DMID
*    IFD/D.LT.DTARGET/THEN
*        DLOW=DMID
*    ELSE
*        DHIGH=DMID
*    ENDIF
ENDDO

DRATIO=(DLOW+DHIGH)/2

DD(1)=0
DD(ICOUNT)=DDIST

DL=DFIRST

DO,J=2,(ICOUNT-1)
    DD(J)=DD(J-1)+DL
    DL=DL*DRATIO
ENDDO

*WRITE,DRATIO,DD

RETSUB
END

