*
*    Podprogram TFOIL
*
SUBRO/TFOIL/in:DL,out:TF(2),out:K1

DIMEN,P1(100),P2(100),P3(100)
DIMEN,Q1(100),Q2(100),Q3(100)

CALL/GAFOIL/'C:\Users\dslav\AppData\Roaming\FreeCAD\v1-1\Mod\NEGWorkbench\gl3data\NACA4415.DAT',P1,K1
CALL/GAFOIL/'C:\Users\dslav\AppData\Roaming\FreeCAD\v1-1\Mod\NEGWorkbench\gl3data\NACA2413.DAT',P2,K2
CALL/GAFOIL/'C:\Users\dslav\AppData\Roaming\FreeCAD\v1-1\Mod\NEGWorkbench\gl3data\NACA2410.DAT',P3,K3

PRINT,K1

DCOOS3,1,(Q00>0,0,-0.1),UX,UY
TRA23,Q1,P1,K1,1

DCOOS3,1,(Q00>0,0,(DL*0.7)),UX,UY
TRA23,Q2,P2,K2,1

DCOOS3,1,(Q00>0,0,(DL+0.1)),UX,UY
TRA23,Q3,P3,K3,1

DIMEN,QQ(3)

DO,I=1,K1
    QQ(1)=Q1(I)
    QQ(2)=Q2(I)
    QQ(3)=Q3(I)
    TF(I)=T01>QQ,3
ENDDO

RETSUB
END
