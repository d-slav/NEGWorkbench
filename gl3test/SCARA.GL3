SUBRO/SCARA/in:SP,out:SS,out:CNAB
DIMEN,PS(11),DS(11)
K=NPO>SP
DH=D11>(P48>SP,1),(L45>VY,(E45>SP),1)
*DH=D11>(P48>SP,1),(L35>VY,SP,1)
SCALE,S,SP,1000/DH,1
DMIN=100000
DO,I=K/3,2*K/3
    D=ABS>(D50>S,(P48>S,I))
    IFD/D.LT.DMIN/THEN
	DMIN=D
	J=I
    ENDIF
ENDDO
E=E45>S,(P48>S,J-3),(P48>S,J+3)
KK=NPO>E
DMIN=100000
P2=P48>E,1
P3=P48>E,2
DO,I=3,KK
    P1=P49>P2
    P2=P49>P3
    P3=P48>E,I
    C=C02>P1,P2,P3
    D=D30>C,3
    IFD/D.LT.DMIN/THEN
	CNAB=C49>C
	DMIN=D
    ENDIF
ENDDO
PS(1)=P47>CNAB
PS(11)=P13>(P48>S,1),(P48>S,K),0.5
DATA,DS,11
0.,0.06,0.14,0.24,0.36,0.5,0.64,0.76,0.86,0.94,1.
DLX=(D30>PS(11),1)-(D30>PS(1),1)
L1=L02>PS(1),VY
DO,I=2,10
    LL=L20>L1,DS(I)*DLX,1
    PP=P13>(P22>LL,S,1),(P22>LL,S,2),0.5
    10: PPA=P42>PP,S,1
        PPB=P42>PP,S,3
        DA=D10>PPA,PP
        DB=D10>PPB,PP
        DC=(DA-DB)/2
        PP=P10>PP,0,DC
        IFD/(ABS>DC),GT,0.001/10
    PS(I)=P49>PP
ENDDO
SS=S01>PS(1),11
SCALE,SS,SS,DH/1000,1
SCALE,CNAB,CNAB,DH/1000,1
RETSUB
END
